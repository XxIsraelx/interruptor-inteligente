PORT=3001
TZ=America/Sao_Paulo
NODE_ENV=development
DATABASE_URL=postgresql://interruptor:interruptor@localhost:5432/interruptor

# ===== MQTT =====
# Broker embutido na API (aedes). Os ESP32 conectam em <ip-do-computador>:1883
MQTT_EMBEDDED_BROKER=true
MQTT_BROKER_PORT=1883
# Usuário/senha exigidos dos ESP32 (vazio = sem autenticação, só para rede local)
MQTT_USERNAME=
MQTT_PASSWORD=
# Para usar um broker externo (ex.: HiveMQ Cloud): MQTT_EMBEDDED_BROKER=false e
# MQTT_URL=mqtts://<cluster>.s1.eu.hivemq.cloud:8883
MQTT_URL=
MQTT_TOPIC_PREFIX=interruptor

# ===== App =====
APP_PASSWORD=troque-esta-senha
JWT_SECRET=troque-este-segredo-grande
# Front em dev roda em outra porta; em produção é a mesma origem
CORS_ORIGIN=http://localhost:3000
# Tarifa de energia em R$/kWh (com impostos) para estimar custo
TARIFF_KWH=0.92
OFFLINE_AFTER_SECONDS=30
# Compactação/retenção do histórico de leituras (mín. 35 dias)
READINGS_RETENTION_DAYS=40

# ===== Demonstração (sem hardware) =====
# Cria 7 dias de histórico falso se o banco estiver vazio
DEMO_SEED=true
# Simula 3 ESP32 (ar-condicionado, geladeira, TV). Desligue quando usar o ESP32 real.
DEMO_SIMULATOR=true
SIM_INTERVAL_MS=5000
